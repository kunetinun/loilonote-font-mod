{
  "manifest_version": 3,
  "name": "LoiLoNote Font Selector MOD",
  "version": "1.3.11",
  "description": "ロイロノートWeb版にフォント選択・ダークモード機能を追加するMOD",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "LoiLoNote Font MOD"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://loilonote.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}